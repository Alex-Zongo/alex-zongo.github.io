# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ingore files created by npm
node_modules
package-lock.json

.bundle/
.jekyll-metadata
/vendor/
.vscode
.DS_Store

# CV sources and LaTeX build outputs stay local; only files/cv.pdf is published
cv/
*.tex
*.cls
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv
!files/cv.pdf
